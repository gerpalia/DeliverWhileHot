    "how_to_play.goal.prepare" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Prepare when the timing circle reaches its small success window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Preparar cuando el círculo llegue a su pequeña ventana de éxito."
