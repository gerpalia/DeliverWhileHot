    "how_to_play.goal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survive the ride with enough health, food, and warmth. At the destination, follow the Prepare and Jump prompts and tap while each circular timer is in its success window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrevive con suficiente salud, comida y calor. Al llegar, sigue las indicaciones Preparar y Saltar, y toca cuando el temporizador circular esté en la zona correcta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobreviva com saúde, comida e calor suficientes. No destino, siga os avisos Preparar e Pular e toque quando o cronômetro circular estiver na janela certa."
          }
        }
      }
    },
