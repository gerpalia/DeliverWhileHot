    "how_to_play.action.block" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That delivery bag might save your life. Block an incoming hit. Time it right for a bonus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa bolsa de entrega podría salvarte la vida. Bloquea un golpe. Si lo haces a tiempo, obtendrás un bonus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa bolsa de entrega pode salvar sua vida. Bloqueie um golpe. Acerte o tempo para ganhar um bônus."
          }
        }
      }
    },
    "how_to_play.action.eat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steal a bite of your customer's food to regain some health. Don't eat it all, or they'll punish you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roba un bocado de la comida del cliente para recuperar salud. No te la comas toda o te castigarán."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roube uma mordida da comida do cliente para recuperar um pouco de vida. Não coma tudo ou vão te punir."
          }
        }
      }
    },
    "how_to_play.action.molotov" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody should ride through dangerous streets unprepared. Throw a Molotov in the direction you're facing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie debería recorrer calles peligrosas sin estar preparado. Lanza un Molotov en la dirección que miras."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém deveria atravessar ruas perigosas sem estar preparado. Lance um Molotov na direção em que está olhando."
          }
        }
      }
    },
    "how_to_play.actions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Block to guard. If a hit arrives within 0.12 seconds of starting the block, you perfect-parry and reflect a projectile. Eat spends 0.25 food (one of four slices) to restore one heart; its cooldown is 3 seconds. Molotov throws in your last movement direction and has a 6-second cooldown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Bloquear para defenderte. Si el impacto llega dentro de los 0,12 segundos de iniciar el bloqueo, haces una parada perfecta y devuelves el proyectil. Comer gasta 0,25 de comida (una de cuatro porciones) para recuperar un corazón; tarda 3 segundos en recargarse. Cóctel se lanza en tu última dirección y tarda 6 segundos en recargarse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure Bloquear para se defender. Se o golpe chegar em até 0,12 segundo após iniciar o bloqueio, você faz uma defesa perfeita e rebate o projétil. Comer gasta 0,25 de comida (uma de quatro fatias) para recuperar um coração; recarrega em 3 segundos. Molotov é lançado na última direção e recarrega em 6 segundos."
          }
        }
      }
    },
    "how_to_play.actions.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acciones"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações"
          }
        }
      }
    },
    "how_to_play.food" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Food slices are your order quality and your recovery resource. Blocking a hit costs one slice; a pigeon can spoil a quarter slice. A roadside delivery bonus restores half a slice. Keep the temperature above the minimum shown by the game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las porciones representan la calidad del pedido y sirven para recuperarte. Bloquear un impacto cuesta una porción; una paloma puede arruinar un cuarto. El bonus de entrega junto a la carretera recupera media porción. Mantén la temperatura por encima del mínimo del juego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fatias representam a qualidade do pedido e também servem para se recuperar. Bloquear um golpe custa uma fatia; um pombo pode estragar um quarto. O bônus de entrega na calçada recupera meia fatia. Mantenha a temperatura acima do mínimo do jogo."
          }
        }
      }
    },
    "how_to_play.food.health" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect the order and your life - which is almost as important."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege el pedido y tu vida, que es casi igual de importante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja o pedido e a sua vida - que é quase tão importante quanto ele."
          }
        }
      }
    },
    "how_to_play.food.molotov" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molotovs can save a delivery, but they are limited—use them when the street truly calls for fire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cócteles pueden salvar una entrega, pero son limitados: úsalos solo cuando la calle realmente pida fuego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os coquetéis podem salvar uma entrega, mas são limitados — use-os apenas quando a rua realmente pedir fogo."
          }
        }
      }
    },
    "how_to_play.food.pizza" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the slices safe. A hungry customer is a dangerous customer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén las porciones a salvo. Un cliente hambriento es un cliente peligroso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha as fatias seguras. Cliente com fome é cliente perigoso."
          }
        }
      }
    },
    "how_to_play.food.temperature" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the order hot. Let it get cold and the delivery is ruined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el pedido caliente. Si se enfría, la entrega está arruinada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o pedido quente. Se esfriar, a entrega está arruinada."
          }
        }
      }
    },
    "how_to_play.food.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect the order"
          }
        },
